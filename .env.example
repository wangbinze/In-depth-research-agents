# DeepSearch Agents 环境变量示例
# 复制为 .env 后按本机实际服务地址和密钥调整，不要提交真实密钥

# LLM 配置  阿里百炼
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_LLM=qwen-max

# LLM 配置  openai 中转站
OPENAI_BASE_URL_GPT=
OPENAI_API_KEY_GPT=
LLM_GPT=


# 当前模型相关配置
CURRENT_BASE_URL=${DASHSCOPE_BASE_URL}
CURRENT_API_KEY=${DASHSCOPE_API_KEY}
CURRENT_LLM=${DASHSCOPE_LLM}

# Tavily 配置
# 在 https://app.tavily.com/ 注册账号，然后创建API KEY
# Tavily 是面向大模型使用的搜索 API，它返回的结果通常已经整理成结构化字段，比较适合 Agent 继续阅读和总结。
TAVILY_API_KEY=

# RAGFlow 配置 (需要本地部署，具体可参看官方教程，文档在docs文件夹中存储)
RAGFLOW_API_URL=
RAGFLOW_API_KEY=

# MySQL 配置
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=deepsearch_db
MYSQL_HOST=localhost
# docs/docker-compose.yaml 建议映射到 3307，避免和本机已有 MySQL 3306 冲突
MYSQL_PORT=3307
# 与初始化 SQL 和 Docker MySQL 服务保持一致，保证中文数据按 utf8mb4 读写
MYSQL_CHARSET=utf8mb4
MYSQL_COLLATION=utf8mb4_unicode_ci
MYSQL_SQL_MODE=TRADITIONAL
